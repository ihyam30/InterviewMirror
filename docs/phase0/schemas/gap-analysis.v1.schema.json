{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviewmirror.local/schemas/gap-analysis.v1.schema.json",
  "title": "InterviewMirror full gap analysis v1",
  "type": "object",
  "required": ["schemaVersion", "gapAnalysisId", "reportId", "matchScore", "formulaVersion", "coverage", "requirements", "gaps", "radar"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "gapAnalysisId": {"type": "string"},
    "reportId": {"type": "string"},
    "matchScore": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "formulaVersion": {"const": "match-40-60.v1"},
    "coverage": {"type": "object", "required": ["evaluated", "total"], "properties": {"evaluated": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "requirements": {"type": "array", "items": {"type": "object", "required": ["requirementId", "text", "importance", "resumeStatus", "interviewStatus", "evidence"], "properties": {"requirementId": {"type": "string"}, "text": {"type": "string"}, "importance": {"enum": ["CORE", "IMPORTANT", "PREFERRED"]}, "importanceWeight": {"type": "number", "minimum": 1, "maximum": 3}, "resumeStatus": {"enum": ["MATCH", "PARTIAL", "NO_EVIDENCE", "UNASSESSED"]}, "resumeScore": {"type": ["number", "null"], "minimum": 0, "maximum": 5}, "interviewStatus": {"enum": ["DEMONSTRATED", "PARTIAL", "NOT_DEMONSTRATED", "UNASSESSED"]}, "interviewScore": {"type": ["number", "null"], "minimum": 0, "maximum": 5}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}, "additionalProperties": false}},
    "gaps": {"type": "array", "items": {"type": "object", "required": ["gapId", "requirementId", "title", "attribution", "gapSize", "confidence", "priorityScore", "priority", "evidence"], "properties": {"gapId": {"type": "string"}, "requirementId": {"type": "string"}, "title": {"type": "string"}, "attribution": {"type": "array", "items": {"enum": ["KNOWLEDGE_GAP", "EXPERIENCE_GAP", "EXPRESSION_GAP"]}, "minItems": 1, "uniqueItems": true}, "gapSize": {"type": "number", "minimum": 0, "maximum": 4}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "priorityScore": {"type": "number", "minimum": 0}, "priority": {"enum": ["HIGH", "MEDIUM", "LOW"]}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}, "additionalProperties": false}},
    "radar": {"type": "array", "items": {"type": "object", "required": ["axis", "requirementScore", "resumeScore", "interviewScore"], "properties": {"axis": {"enum": ["SKILLS", "PROJECT_EXPERIENCE", "PROBLEM_SOLVING", "ROLE_RESPONSIBILITIES"]}, "requirementScore": {"type": ["number", "null"], "minimum": 0, "maximum": 5}, "resumeScore": {"type": ["number", "null"], "minimum": 0, "maximum": 5}, "interviewScore": {"type": ["number", "null"], "minimum": 0, "maximum": 5}}, "additionalProperties": false}},
    "generatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "evidence": {"type": "object", "required": ["sourceType", "sourceId", "snapshotId", "locator", "quote", "confidence"], "properties": {"sourceType": {"enum": ["JD", "RESUME", "TURN"]}, "sourceId": {"type": "string"}, "snapshotId": {"type": "string"}, "locator": {"type": "object", "properties": {"page": {"type": ["integer", "null"], "minimum": 1}, "paragraph": {"type": ["integer", "null"], "minimum": 0}, "turnId": {"type": ["string", "null"]}, "start": {"type": ["integer", "null"], "minimum": 0}, "end": {"type": ["integer", "null"], "minimum": 0}}, "additionalProperties": false}, "quote": {"type": "string", "minLength": 1, "maxLength": 500}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
