{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviewmirror.local/schemas/interview-request.v1.schema.json",
  "title": "InterviewMirror interview create request v1",
  "type": "object",
  "required": ["schemaVersion", "clientRequestId", "mode"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "clientRequestId": {"type": "string", "minLength": 1, "maxLength": 100},
    "mode": {"enum": ["COMPREHENSIVE", "QUESTION_BANK"]},
    "resumeId": {"type": "string", "minLength": 1, "maxLength": 100},
    "questionBankId": {"type": "string", "minLength": 1, "maxLength": 100},
    "jdText": {"type": "string", "maxLength": 1500},
    "locale": {"const": "zh-CN"}
  },
  "oneOf": [
    {
      "properties": {"mode": {"const": "COMPREHENSIVE"}},
      "required": ["resumeId"],
      "not": {"required": ["questionBankId"]}
    },
    {
      "properties": {"mode": {"const": "QUESTION_BANK"}},
      "required": ["questionBankId"],
      "not": {"anyOf": [{"required": ["resumeId"]}, {"required": ["jdText"]}]}
    }
  ],
  "additionalProperties": false
}
