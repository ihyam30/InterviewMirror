# Local-only environment. Copy to .env; never use these example values outside a private local machine.
DATABASE_NAME=interviewmirror
DATABASE_USER=interviewmirror
DATABASE_PASSWORD=local-only-change-this-db-password
DATABASE_PORT=15432

# MinIO source release built locally because upstream no longer distributes its Community container.
# The upstream repository is archived; local demo use only.
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
MINIO_ROOT_USER=interviewmirror-local
MINIO_ROOT_PASSWORD=local-only-change-this-storage-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=interviewmirror-private

BACKEND_PORT=8080
FRONTEND_PORT=5173
DEMO1_PASSWORD=MirrorDemo1!
DEMO2_PASSWORD=MirrorDemo2!
