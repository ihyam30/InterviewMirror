# Local-only environment. Copy to .env; never use these example values outside a private local machine.
DATABASE_NAME=interviewmirror
DATABASE_USER=interviewmirror
DATABASE_PASSWORD=local-only-change-this-db-password
DATABASE_PORT=15432

# Resume parsing and asynchronous grading (MinIO + PostgreSQL + Redis).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RESUME_WORKER_ENABLED=true
RESUME_STRUCTURED_CONTENT_ENABLED=false
RESUME_ALLOWED_EXTENSIONS=pdf,doc,docx,txt
RESUME_PARSE_TIMEOUT=PT2M
RESUME_PARSE_CONCURRENCY=2
RESUME_TEXT_LIMIT=100000
RESUME_PAGE_LIMIT=50
RESUME_OCR_LANGUAGES=chi_sim+eng
TESSERACT_PATH=
RESUME_MODEL_TIMEOUT=PT180S
RESUME_PENDING_TIMEOUT=PT10M
RESUME_PROCESSING_TIMEOUT=PT15M
RESUME_UPLOAD_GLOBAL_RATE=60
RESUME_UPLOAD_IP_RATE=5
RESUME_UPLOAD_USER_RATE=5

# MinIO source release built locally because upstream no longer distributes its Community container.
# The upstream repository is archived; local demo use only.
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
MINIO_ROOT_USER=interviewmirror-local
MINIO_ROOT_PASSWORD=local-only-change-this-storage-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=interviewmirror-private

BACKEND_PORT=8080
FRONTEND_PORT=5173
DEMO1_PASSWORD=MirrorDemo1!
DEMO2_PASSWORD=MirrorDemo2!
MINERU_WORKER_URL=http://host.docker.internal:8765
MINERU_WORKER_TOKEN=replace-with-a-unique-64-character-random-token
LANGGRAPH4J_ENABLED=true
INTERVIEW_MODEL_ENABLED=false
INTERVIEW_MODEL_PROVIDER=QWEN
INTERVIEW_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INTERVIEW_MODEL_API_KEY=replace-with-a-provider-key
INTERVIEW_MODEL_ID=qwen-plus-2025-12-01
REPORT_WORKER_ENABLED=true
REPORT_WORKER_ID=report-worker-local
REPORT_POLL_INTERVAL=PT2S
REPORT_TASK_LEASE=PT5M
REPORT_MODEL_TIMEOUT=PT180S
# Leave empty to use the CJK font installed in the backend container image.
PDF_CJK_FONT_PATH=
